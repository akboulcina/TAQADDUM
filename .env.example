# Documentation only: this file is not automatically loaded by the API.
# Supply actual values via Codespaces secrets or the shell environment.
# Never commit a completed .env file or paste its contents into chat/logs.
DATABASE_URL=
NODE_ENV=local
PORT=3000
# Exact origins only; blank means no cross-origin allowlist entries.
# Same-origin frontend API requests should continue through the Vite proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# This API configuration change does not rotate an existing database password,
# change Docker Compose credentials, or configure a production deployment.
